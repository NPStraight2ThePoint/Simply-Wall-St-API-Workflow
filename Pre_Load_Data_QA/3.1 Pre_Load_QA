import pandas as pd
from dir_utils import *
from qa_utils import *
import os
from datetime import datetime

keywords = ["Insider_Transactions", "Listings", "Members", "Owners", "Transposed"]

# Main function to process all data and create Rec File
def main():

    # Step 1: Call the utility function to process the directories
    process_directories(BASE_DIRECTORIES, keywords)

    # Step 2: retry errors and expected counts
    retry_errors = load_retry_errors(LOG_PATH[0])
    expected_counts = load_expected_counts(EXCHANGES_CSV_PATH)

    # Process row counts and aggregate data
    summary_data = process_row_counts(BASE_DIRECTORIES)

    # Create the final summary DataFrame
    summary_df = create_summary_df(summary_data, retry_errors, expected_counts)

    os.makedirs(output_dir, exist_ok=True)
    output_file = os.path.join(output_dir, "Rec File.csv")
    summary_df.to_csv(output_file, index=False)

    print(f"Updated 'Rec File.csv' at {output_file}")
    print("Processing complete.")

    process_and_transpose_rec_file(Rec_File, Transposed_Rec_File)

# 📌
if __name__ == "__main__":
    main()
