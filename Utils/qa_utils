# Correct connection using psycopg2 (individual parameters)
def run_deduplication_query(db_params, table_name, partition_columns, priority_order=None):
    try:
        # Prepare the ranking order logic
        order_clause = priority_order if priority_order else "ctid"

        # Format the partition key
        partition_key = ', '.join(partition_columns)
        where_condition = f"({partition_key})"

        # Build the SQL query dynamically
        sql_query = f"""
        DO $$ 
        BEGIN
            WITH ranked_rows AS (
                SELECT ctid,
                       ROW_NUMBER() OVER (
                           PARTITION BY {partition_key}
                           ORDER BY {order_clause}
                       ) AS rn
                FROM {table_name}
                WHERE {where_condition} IN (
                    SELECT {partition_key}
                    FROM {table_name}
                    GROUP BY {partition_key}
                    HAVING COUNT(*) > 1
                )
            )
            DELETE FROM {table_name}
            WHERE ctid IN (
                SELECT ctid
                FROM ranked_rows
                WHERE rn > 1
            );
            RAISE NOTICE '✅ Duplicates removed from {table_name}.';
        END $$;
        """

        # Connect using individual parameters
        conn = psycopg2.connect(
            dbname=db_params['database'],
            user=db_params['username'],
            password=db_params['password'],
            host=db_params['host'],
            port=db_params['port']
        )

        # Execute the query
        with conn.cursor() as cur:
            cur.execute(sql_query)
            conn.commit()
        print(f"✅ Duplicates deleted successfully from {table_name}.")

    except Exception as e:
        print(f"❌ Error deleting duplicates from {table_name}: {e}")

    finally:
        if conn:
            conn.close()


def export_and_compare_data(today, output_file, transposed_file, db_params):
    conn = None  # Initialize conn variable to avoid reference errors
    try:
        print(f"Connecting to database {db_params['dbname']}...")
        conn = psycopg2.connect(**db_params)

        # SQL query with date filter
        query = f'''
            SELECT * 
            FROM public."EOM_Reconciliation"
            WHERE date = '{today}';
        '''

        print(f"Running query for date: {today}")
        df = pd.read_sql(query, conn)
        print(f"✅ Data retrieved, exporting to {output_file}...")
        df.to_csv(output_file, index=False)
        print(f"✅ Data exported successfully to {output_file} for date: {today}")

    except Exception as e:
        print(f"❌ Error exporting data: {e}")

    finally:
        if conn:
            conn.close()

    # Step 2: Load both files for comparison
    try:
        print(f"Loading file1 from {transposed_file}...")
        file1 = pd.read_csv(transposed_file)
        print(f"File1 loaded successfully. Loading file2 from {output_file}...")
        file2 = pd.read_csv(output_file)

        # Convert column names to lowercase for case-insensitive comparison
        file1.columns = file1.columns.str.lower()
        file2.columns = file2.columns.str.lower()

        # Define which columns to compare (also lowercase now)
        columns_to_compare = [
            "insider_transactions_received",
            "listings_received",
            "members_received",
            "owners_received",
            "statements_received"
        ]

        # Merge the dataframes on 'exchange'
        merged = pd.merge(
            file1,
            file2,
            on='exchange',
            suffixes=('_file1', '_file2')
        )

        # Prepare the diff dataframe
        diff_df = pd.DataFrame()
        diff_df['exchange'] = merged['exchange']

        # Compare only the specified columns
        for col in columns_to_compare:
            col_file1 = f"{col}_file1"
            col_file2 = f"{col}_file2"
            diff_col = f"diff_{col}"
            diff_df[diff_col] = merged[col_file2] - merged[col_file1]

        # Save the result
        diff_output_file = r"C:\............\Data\Rec File\final_difference.csv"
        diff_df.to_csv(diff_output_file, index=False)
        print("✅ Final difference CSV created successfully.")

    except Exception as e:
        print(f"❌ Error in comparison: {e}")


