import pandas as pd


# Function to process and transpose the Rec File
def process_and_transpose_rec_file(input_file, output_file):
    # Read the original Rec File
    df = pd.read_csv(input_file)

    # Pivot the dataframe
    pivot_df = df.pivot_table(index=['Date', 'Exchange'],
                              columns='Type',
                              values=['Rows', 'Errors', 'Expected', 'Reconciled'],
                              aggfunc='first')

    # Flatten the multi-level columns
    pivot_df.columns = [f'{col[1]}_{col[0]}' for col in pivot_df.columns]
    pivot_df.reset_index(inplace=True)

    # Save the transposed dataframe
    pivot_df.to_csv(output_file, index=False)

    # Re-read the transposed file to reorder columns
    df = pd.read_csv(output_file)
    columns = df.columns.tolist()

    # Reorder the columns as per the specification
    ordered_columns = ['Date', 'Exchange']
    ordered_columns.extend([col for col in columns if '_Rows' in col])
    ordered_columns.extend([col for col in columns if '_Errors' in col])
    ordered_columns.extend([col for col in columns if '_Expected' in col])
    ordered_columns.extend([col for col in columns if '_Reconciled' in col])

    df = df[ordered_columns]
    df.to_csv(output_file, index=False)

    # Final re-ordering of column names
    df = pd.read_csv(output_file)
    df.columns = df.columns.str.replace('_Rows', '_Received')
    df.columns = df.columns.str.replace('Transposed', 'Statements')
    df.columns = df.columns.str.replace('_Reconciled', '_Difference')

    # Save the final processed file
    df.to_csv(output_file, index=False)

    print(f"Processed and saved to: {output_file}")

