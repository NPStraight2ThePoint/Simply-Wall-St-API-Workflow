from datetime import datetime
from evnv_utils import *
import psycopg2

today = datetime.now().replace(day=1).strftime("%Y-%m-%d")

def create_lock_trigger_sql(table_name, date_column, today):
    return f"""
    -- Create a function to raise an error if modifying past data
    CREATE OR REPLACE FUNCTION prevent_modification_before_today()
    RETURNS TRIGGER AS $$
    BEGIN
        IF (TG_OP = 'UPDATE' OR TG_OP = 'DELETE') THEN
            IF OLD.{date_column} < DATE '{today}' THEN
                RAISE EXCEPTION 'Modifications before {today} are not allowed.';
            END IF;
        ELSIF (TG_OP = 'INSERT') THEN
            IF NEW.{date_column} < DATE '{today}' THEN
                RAISE EXCEPTION 'Inserts with a date before {today} are not allowed.';
            END IF;
        END IF;
        RETURN NEW;
    END;
    $$ LANGUAGE plpgsql;

    -- Drop existing trigger if it exists
    DROP TRIGGER IF EXISTS prevent_mods_before_today_trigger ON {table_name};

    -- Create a trigger on the table
    CREATE TRIGGER prevent_mods_before_today_trigger
    BEFORE INSERT OR UPDATE OR DELETE ON {table_name}
    FOR EACH ROW EXECUTE FUNCTION prevent_modification_before_today();
    """

tables = [
    ('listings', 'date'),
    ('members', 'date'),
    ('owners', 'date'),
    ('statements', 'date'),
    ('insider_transactions', 'date'),
    ('exchanges_counts', 'index_date')
]

try:
    with psycopg2.connect(**db_params) as conn:
        with conn.cursor() as cur:
            for table, date_col in tables:
                sql = create_lock_trigger_sql(table, date_col, today)
                cur.execute(sql)
        conn.commit()
    print("🚫 Lock triggers added to prevent changes before today's date.")
except Exception as e:
    print(f"❌ Error applying triggers: {e}")


def unlock_table_for_modifications(db_params, table_name):
    try:
        # Get today's date in 'YYYY-MM-DD' format
        today = datetime.now().strftime("%Y-%m-%d")

        # Create the SQLAlchemy engine with provided database parameters
        connection_string = f"postgresql://{db_params['username']}:{db_params['password']}@{db_params['host']}:{db_params['port']}/{db_params['database']}"
        engine = create_engine(connection_string)

        # Define the query to remove the date condition
        query = f"""
            UPDATE {table_name}
            SET column_name = new_value
            WHERE date < '{today}';
        """

        # Execute the query to unlock the table from date-based lock
        with engine.connect() as conn:
            conn.execute(text(query))
            conn.commit()

        print(f"✅ Successfully unlocked the table {table_name} for modifications.")

    except Exception as e:
        print(f"❌ Error unlocking {table_name}: {e}")
